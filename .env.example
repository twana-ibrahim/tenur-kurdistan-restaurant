# Canonical origin. Without this, canonical URLs, hreflang and the sitemap all
# point at the placeholder domain.
NEXT_PUBLIC_SITE_URL=https://tenur.krd

# Where reservations are delivered. Any endpoint accepting a JSON POST: a form
# service, an inbox relay, or a booking system. Leave unset in development and
# submissions are validated and logged instead.
RESERVATION_WEBHOOK_URL=
